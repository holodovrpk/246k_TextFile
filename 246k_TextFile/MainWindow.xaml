<Window x:Class="_246k_TextFile.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_246k_TextFile"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <TextBlock Text="⏰ Напоминалка" Margin="10" FontSize="40" Foreground="BlueViolet"/>
        <!-- Таблица напоминаний -->
        <DataGrid x:Name="RemindersGrid"
          Height="150" 
          Grid.Row="1"
          AutoGenerateColumns="False" 
          IsReadOnly="False"
          Margin="10,10,10,10"
          AlternatingRowBackground="#E3F2FD"
          HeadersVisibility="Column">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Часы" Binding="{Binding Hour}" Width="70"/>
                <DataGridTextColumn Header="Минуты" Binding="{Binding Minute}" Width="70"/>
                <DataGridTextColumn Header="Текст" Binding="{Binding Text}" Width="*"/>
                <DataGridCheckBoxColumn Header="Показано" Binding="{Binding IsShown}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBox x:Name="txtHour" Width="50" Margin="10"/>
            <TextBox x:Name="txtMin" Width="50" Margin="10"/>
            <TextBox x:Name="txtText" Width="450" Margin="10"/>
            <Button Content="Добавить" Width="130" Margin="10" Background="LightGreen"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Margin="10">
           
            <Button Content="📁 Открыть" Width="130" Margin="10" Background="LightBlue" Foreground="White"/>
            <Button Content="💾 Сохранить" Width="130" Margin="10" Background="Blue" Foreground="White"/>
            <Button Content="🗑️ Удалить" Width="130" Margin="10" Background="Red" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
